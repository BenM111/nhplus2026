<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="855.0"
            xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.hitec.nhplus.controller.AllUserController"
            stylesheets="@Application.css">
    <children>
        <HBox alignment="TOP_CENTER" layoutX="10.0" layoutY="10.0" prefWidth="200.0" spacing="25.0"
              AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="5.0">
            <children>
                <Label alignment="CENTER" contentDisplay="CENTER" minWidth="400.0"
                       text="Benutzerverwaltung" textAlignment="CENTER">
                    <font>
                        <Font size="36.0" />
                    </font>
                </Label>
            </children>
        </HBox>
        <TableView fx:id="tableView" editable="false"
                   layoutX="15.0" layoutY="80.0"
                   AnchorPane.bottomAnchor="155.0"
                   AnchorPane.leftAnchor="15.0"
                   AnchorPane.rightAnchor="15.0"
                   AnchorPane.topAnchor="80.0">
            <columns>
                <TableColumn fx:id="columnId" prefWidth="40.0" text="ID" />
                <TableColumn fx:id="columnUsername" prefWidth="180.0" text="Benutzername" />
                <TableColumn fx:id="columnRole" prefWidth="100.0" text="Rolle" />
                <TableColumn fx:id="columnCreatedAt" prefWidth="120.0" text="Erstellt am" />
                <TableColumn fx:id="columnLastLogin" prefWidth="120.0" text="Letzter Login" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <HBox layoutX="15.0" spacing="10.0"
              AnchorPane.bottomAnchor="15.0"
              AnchorPane.leftAnchor="15.0"
              AnchorPane.rightAnchor="15.0">
            <children>
                <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="LEFT" hgrow="SOMETIMES" prefWidth="200.0" />
                        <ColumnConstraints halignment="LEFT" hgrow="SOMETIMES" prefWidth="200.0" />
                        <ColumnConstraints halignment="LEFT" hgrow="SOMETIMES" prefWidth="160.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <TextField fx:id="textFieldUsername" prefHeight="26.0" prefWidth="200.0"
                                   promptText="Benutzername" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <PasswordField fx:id="passwordField" prefHeight="26.0" prefWidth="200.0"
                                       promptText="Passwort" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <ComboBox fx:id="roleComboBox" prefHeight="26.0" prefWidth="160.0"
                                  promptText="Rolle wählen" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <Label fx:id="labelError" text="" textFill="#c0392b" wrapText="true" visible="false"
                               GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="3" />
                    </children>
                    <padding>
                        <Insets right="10.0" />
                    </padding>
                </GridPane>
                <HBox alignment="TOP_CENTER" prefWidth="190.0" spacing="10.0">
                    <children>
                        <Button fx:id="buttonAdd" mnemonicParsing="false" onAction="#handleAdd"
                                prefWidth="90.0" text="Hinzufügen" />
                        <Button fx:id="buttonDelete" mnemonicParsing="false" onAction="#handleDelete"
                                prefWidth="90.0" text="Löschen" />
                    </children>
                </HBox>
            </children>
        </HBox>

    </children>
    <padding>
        <Insets top="10.0" />
    </padding>
</AnchorPane>
