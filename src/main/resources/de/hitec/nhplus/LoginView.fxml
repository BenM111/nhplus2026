<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox fx:controller="de.hitec.nhplus.controller.LoginController" alignment="CENTER" prefHeight="300.0" prefWidth="420.0" spacing="15.0" stylesheets="@Application.css" xmlns="http://javafx.com/javafx/10.0.2-internal" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="40.0" left="60.0" right="60.0" top="40.0" />
    </padding>
    <children>
        <Label text="NHPlus — Anmeldung">
            <font>
                <Font size="22.0" />
            </font>
        </Label>
        <TextField fx:id="usernameField" promptText="Benutzername" />
        <PasswordField fx:id="passwordField" promptText="Passwort" />
        <Button fx:id="buttonLogin" defaultButton="true" onAction="#handleLogin" maxWidth="Infinity" mnemonicParsing="false" text="Anmelden" />
        <Label fx:id="labelError" text="" textFill="#c0392b" visible="false" wrapText="true" />
    </children>
</VBox>
